// Your organization's diServer. See https://github.com/tommasoseita/diServer/blob/main/docs/setup.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diserver",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diserver",
      // Where the data lives (docs/setup.md, "Where the data lives"):
      // - the Deploy to Cloudflare button ignores this line and creates the database itself,
      //   with no jurisdiction. In Europe, create the database in the EU first and pick it in
      //   the button's form: its "database_id" then takes the place of this line;
      // - deploying by hand without a "database_id", wrangler (4.159 or later) creates the
      //   database at the first deploy in this jurisdiction.
      "jurisdiction": "eu",
      // The schema ships with the package, so updates bring their migrations.
      "migrations_dir": "node_modules/diserver/migrations"
    }
  ],
  "vars": {
    // Shown on invite pages and in the apps until an admin renames the organization.
    "ORG_NAME": "My organization"
    // Optional (see docs/setup.md): "MISTRAL_BASE_URL": "https://api.eu.mistral.ai"
  },
  "observability": { "enabled": true }
}
